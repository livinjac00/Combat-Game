@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<PageTitle>Combat Game</PageTitle>

<h1>Welcome to the Combat Game!</h1>


<div style="position: absolute; left: 500px; top: 400px;">
    <button @onclick="GoToCharacterSelect">Start Game</button>
    <br />
    <br />
    <button @onclick="ExitGame">Exit Game</button>
</div>


@code {
    public void GoToCharacterSelect()
    {
        NavigationManager.NavigateTo($"/character-select");
    }

    public void ExitGame()
    {
        Environment.Exit(0);
    }

}