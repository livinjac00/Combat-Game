@page "/game"
@rendermode InteractiveServer
@inject NavigationManager navigation

<div style="position: relative; width: 100%; height: 500px; border: 3px solid #333; background-color: #f0f0f0; overflow: hidden; font-family: 'Courier New', Courier, monospace;">
    
    <!-- Battle Stage Info -->
    <div style="text-align: center; padding: 10px; background: #333; color: white;">
        <h2>@(IsPlayer1Turn ? "PLAYER 1'S TURN" : "PLAYER 2'S TURN")</h2>
    </div>

    <!-- player top right -->
    <div style="position: absolute; right: 100px; top: 80px; width: 140px; text-align: center;">
        <div style="font-weight: bold; margin-bottom: 5px;">@GameEngine.Player2.Name</div>
        <div style="background-color: #ddd; width: 100%; height: 15px; border: 2px solid #555; border-radius: 8px; margin-bottom: 5px;">
            <div style="background-color: red; width: @(player2.Health)%; height: 100%; border-radius: 5px; transition: width 0.5s;"></div>
        </div>
        <div>@player2.Health / 100 HP</div>
           <img src="@GetCharacterImage(player2.Name)"
               alt="@player2.Name"
             style="width: 90px; height: 90px; margin: 10px auto; display: block; object-fit: contain; @( !IsPlayer1Turn ? "filter: drop-shadow(0 0 8px #00ff00);" : "")" />
    </div>

    <!-- player bottom left -->
    <div style="position: absolute; left: 100px; bottom: 150px; width: 140px; text-align: center;">
           <img src="@GetCharacterImage(player1.Name)"
               alt="@player1.Name"
             style="width: 90px; height: 90px; margin: 10px auto; display: block; object-fit: contain; @(IsPlayer1Turn ? "filter: drop-shadow(0 0 8px #00ff00);" : "")" />
        <div style="font-weight: bold; margin-top: 5px;">@GameEngine.Player1.Name</div>
        <div style="background-color: #ddd; width: 100%; height: 15px; border: 2px solid #555; border-radius: 8px; margin-top: 5px;">
            <div style="background-color: #00ff00; width: @(player1.Health)%; height: 100%; border-radius: 5px; transition: width 0.5s;"></div>
        </div>
        <div>@player1.Health / 100 HP</div>
    </div>

    <!-- Combat Log / Dialogue Box -->
    <div style="position: absolute; bottom: 20px; left: 20px; right: 20px; height: 100px; background: white; border: 4px solid #333; padding: 15px; overflow-y: auto; font-size: 1.1em;">
        <strong>> @message</strong>
    </div>

    // shared by both players 
    @if (!GameOver)
    {
        <div style="position: absolute; bottom: 30px; right: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; background: #fff; padding: 10px; border: 3px solid #333;">
            <button style="padding: 10px; font-weight: bold; cursor: pointer; background-color: @(IsPlayer1Turn ? "#e6f3ff" : "#ffe6e6");" @onclick='() => ExecuteAction("Light attack")'>LIGHT ATTACK</button>
            <button style="padding: 10px; font-weight: bold; cursor: pointer; background-color: @(IsPlayer1Turn ? "#e6f3ff" : "#ffe6e6");" @onclick='() => ExecuteAction("Heavy Attack")'>HEAVY ATTACK</button>
            <button style="padding: 10px; font-weight: bold; cursor: pointer; background-color: @(IsPlayer1Turn ? "#e6f3ff" : "#ffe6e6");" @onclick='() => ExecuteAction("Elemental attack")'>ELEMENTAL</button>
            <button style="padding: 10px; font-weight: bold; cursor: pointer; background-color: @(IsPlayer1Turn ? "#e6f3ff" : "#ffe6e6");" @onclick='() => ExecuteAction("Dodge")'>DODGE STANCE</button>
        </div>
    }
</div>

@if (GameOver)
{
    <div style="text-align: center; margin-top: 20px;">
        <button @onclick="ResetGame" style="padding: 15px 30px; font-size: 1.2em; cursor: pointer;">REMATCH</button>
        <button @onclick="GoToEndScreen" style="padding: 15px 30px; font-size: 1.2em; cursor: pointer; margin-left: 10px;">VIEW RESULTS</button>
    </div>
}

@code {
    Character player1 = GameEngine.Player1.PlayerCharacter ?? new Character("Player 1", 100, 10, ElementType.Fire, 5, false);
    Character player2 = GameEngine.Player2.PlayerCharacter ?? new Character("Player 2", 100, 10, ElementType.Water, 5, false);

    bool IsPlayer1Turn = true;
    bool GameOver = false;
    string winnerName = "";
    string message = "Local Multi-player Battle! Player 1, choose your move.";

    private void ExecuteAction(string actionType)
    {
        if (GameOver) return;

        Character attacker = IsPlayer1Turn ? player1 : player2;
        Character target = IsPlayer1Turn ? player2 : player1;

        if (actionType == "Dodge")
        {
            attacker.IsDodging = true;
            message = $"{attacker.Name} entered a defensive stance!";
        }
        else
        {
            
            Player pAttacker = new Player(IsPlayer1Turn ? 1 : 2, attacker.Name, attacker);
            Player pTarget = new Player(IsPlayer1Turn ? 2 : 1, target.Name, target);

            CombatEngine.PerformAttack(pAttacker, pTarget, actionType);
            message = $"{attacker.Name} used {actionType}!";
            
            if (target.Health <= 0)
            {
                message = $"{target.Name} fainted! {attacker.Name} wins the duel!";
                winnerName = attacker.Name;
                GameOver = true;
                return;
            }
        }

        // Toggle turn
        IsPlayer1Turn = !IsPlayer1Turn;
        message += $" It is now { (IsPlayer1Turn ? "Player 1's" : "Player 2's") } turn.";
        StateHasChanged();
    }

    private void ResetGame()
    {
        player1 = new Character("Player 1", 100, 10, ElementType.Fire, 5, false);
        player2 = new Character("Player 2", 100, 10, ElementType.Water, 5, false);
        IsPlayer1Turn = true;
        GameOver = false;
        winnerName = "";
        message = "Game Reset! Player 1, choose your move.";
    }

    public void GoToEndScreen()
    {
        navigation.NavigateTo($"/end-screen?winner={Uri.EscapeDataString(winnerName)}");
    }

    private string GetCharacterImage(string? characterName)
    {
        return characterName switch
        {
            "Fire Knight" => "/Knight.svg",
            "Water Mage" => "/Mage.svg",
            "Earth Barbarian" => "/Barbarian.svg",
            "Air Archer" => "/Archer.svg",
            _ => "/Knight.svg"
        };
    }
}
